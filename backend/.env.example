# Database connection (PostgreSQL for production, or omit for local SQLite)
DATABASE_URL=postgresql://user:password@host:5432/medivista

# JWT Security
JWT_SECRET_KEY=replace-with-a-strong-random-64-char-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS (add your Vercel frontend URL)
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Default seeded demo clinician account
DEMO_DOCTOR_USERNAME=dr.nehra
DEMO_DOCTOR_PASSWORD=doctor123
DEMO_DOCTOR_NAME=Dr. Deepen Nehra, MD
